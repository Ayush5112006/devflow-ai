# Public configuration for InsightBoard.
# Copy to .env and adjust. Never commit real credentials.

# Base URL the browser bundle uses to reach the InsightBoard API.
VITE_API_URL=http://localhost:3000

# Port the API listens on.
PORT=3000

# Runtime mode: development | test | production.
NODE_ENV=development

# SQLite file location (defaults to server/db/insightboard.db).
DB_FILE=server/db/insightboard.db

# Internal billing gateway.
BILLING_GATEWAY_URL=https://billing.internal.example.com
